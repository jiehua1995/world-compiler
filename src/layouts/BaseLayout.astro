---
import type { DictionaryKey } from '../i18n/dictionaries';
import type { LocalizedText } from '../i18n/types';
import { dictionary } from '../i18n/dictionaries';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/shell.css';

interface Props {
  titleKey?: DictionaryKey;
  descriptionKey?: DictionaryKey;
  title?: LocalizedText;
  description?: LocalizedText;
}

const { titleKey = 'site.title', descriptionKey = 'site.description', title, description } = Astro.props;
const titles = title ?? { 'zh-CN': dictionary('zh-CN')[titleKey], en: dictionary('en')[titleKey], de: dictionary('de')[titleKey] };
const descriptions = description ?? { 'zh-CN': dictionary('zh-CN')[descriptionKey], en: dictionary('en')[descriptionKey], de: dictionary('de')[descriptionKey] };
---

<!doctype html>
<html lang="zh-CN" data-theme="light" data-theme-preference="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3f0e8" />
    <link rel="manifest" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/manifest.webmanifest`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/pwa-192.png`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/pwa-icon.svg`} type="image/svg+xml" />
    <meta
      name="description"
      content={descriptions['zh-CN']}
      data-description-zh={descriptions['zh-CN']}
      data-description-en={descriptions.en}
      data-description-de={descriptions.de}
    />
    <title data-title-zh={titles['zh-CN']} data-title-en={titles.en} data-title-de={titles.de}>{titles['zh-CN']}</title>
    <script is:inline>
      (() => {
        let preference = 'system';
        try {
          const stored = localStorage.getItem('world-compiler:theme');
          if (stored === 'light' || stored === 'dark' || stored === 'system') preference = stored;
        } catch {}
        const dark = preference === 'dark' ||
          (preference === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.dataset.themePreference = preference;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content" data-i18n="a11y.skipToContent">跳到主要内容</a>
    <div class="site-frame">
      <SiteHeader />
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <SiteFooter />
    </div>
    <script>
      import { initializePreferences } from '../scripts/preferences';

      const preferences = initializePreferences(document, window);

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const themeControl = target.closest<HTMLElement>('[data-theme-value]');
        const nextTheme = themeControl?.dataset.themeValue;
        if (nextTheme === 'system' || nextTheme === 'light' || nextTheme === 'dark') {
          preferences.setTheme(nextTheme);
        }
      });

      window.addEventListener('pagehide', () => preferences.destroy(), { once: true });
    </script>
  </body>
</html>
