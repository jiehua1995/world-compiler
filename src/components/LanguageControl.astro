<div class="preference-control preference-control--language">
  <label id="language-label" class="preference-control__label" for="language-select" data-i18n="language.label">语言</label>
  <select id="language-select" data-locale-select aria-labelledby="language-label">
    <option value="zh-CN" data-i18n="language.zh">中文</option>
    <option value="en" data-i18n="language.en">English</option>
    <option value="de" data-i18n="language.de">Deutsch</option>
  </select>
</div>
