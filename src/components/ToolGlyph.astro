---
{icon && paths[icon] ? <span class="instrument-glyph instrument-glyph--vector" aria-hidden="true"><svg viewBox="0 0 64 64" focusable="false">{paths[icon].map((d,i)=><path d={d} class={i===0?'glyph-main':'glyph-detail'} />)}</svg></span> : <span class="instrument-glyph" aria-hidden="true" style={`--glyph-sheet:url('${base}assets/instrument-glyphs/contact-sheet.png');--glyph-position:${((index % 6 + .05) / 5.1) * 100}% ${((Math.floor(index / 6) + .05) / 5.1) * 100}%`}></span>}
<style is:global>
.instrument-glyph { position:relative; display:inline-block; flex:none; width:7rem; aspect-ratio:1; border-radius:.8rem; background-color:#fffdf8; overflow:hidden; }
.instrument-glyph::after { content:''; position:absolute; inset:8%; background-image:var(--glyph-sheet); background-position:var(--glyph-position); background-size:666.6667% 666.6667%; }
.instrument-glyph--vector { display:grid; place-items:center; border:1px solid var(--line); background:color-mix(in srgb,var(--institution-blue) 8%,var(--paper-raised)); }
.instrument-glyph--vector::after { content:none; }
.instrument-glyph--vector svg { width:82%; height:82%; fill:none; stroke:var(--institution-blue); stroke-width:2.6; stroke-linecap:round; stroke-linejoin:round; }
.instrument-glyph--vector .glyph-detail { stroke:var(--lunar-violet); stroke-width:2.1; }
.instrument-glyph--vector .glyph-detail:last-child { stroke:var(--signal-coral); }
.tool-card__visual .instrument-glyph { width:min(80%, 8rem); }
</style>
