<div class="catalog-controls">
  <label class="catalog-search">
    <span data-i18n="catalog.search">搜索工具</span>
    <input type="search" data-catalog-search placeholder="输入名称、任务或关键词" data-i18n-placeholder="catalog.searchPlaceholder" />
  </label>
  <div class="catalog-categories" role="group" aria-labelledby="category-label">
    <span id="category-label" data-i18n="catalog.category">工具分类</span>
    <div>
      <button type="button" data-category="all" aria-pressed="true" data-i18n="category.all">全部</button>
      <button type="button" data-category="vision" aria-pressed="false" data-i18n="category.vision">视觉</button>
      <button type="button" data-category="text" aria-pressed="false" data-i18n="category.text">文本</button>
      <button type="button" data-category="data" aria-pressed="false" data-i18n="category.data">数据</button>
      <button type="button" data-category="media" aria-pressed="false" data-i18n="category.media">媒体</button>
    </div>
  </div>
</div>
