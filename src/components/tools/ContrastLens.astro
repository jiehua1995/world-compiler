---
import Copy from '../Copy.astro';
const palette = [['Amber', '#FCA104'], ['Blue', '#2F6DB3'], ['Coral', '#E56C57'], ['Violet', '#5200A6'], ['Gold', '#CDB742'], ['Teal', '#45A6B2']];
---
<section class="lab" data-contrast-lens>
  <div class="lab-toolbar"><Copy text={['配色预设','Color presets','Farbvorlagen']} />{[['#2F6DB3','#FFFFFF','蓝 / Blue'],['#101A27','#FCA104','琥珀 / Amber'],['#FFFFFF','#5200A6','紫 / Violet']].map(([fg,bg,name]) => <button type="button" data-preset-fg={fg} data-preset-bg={bg} aria-label={`${fg} / ${bg}`} style={`border-bottom:4px solid ${fg}`}>{name.split(' / ')[1]}</button>)}<button type="button" data-swap><Copy text={['交换颜色 ⇄','Swap colors ⇄','Farben tauschen ⇄']} /></button></div>
  <div class="lab-grid">
    <section class="lab-panel">
      <header><b>01</b><Copy as="h2" text={['颜色与排版','Colors & typography','Farben & Typografie']} /></header>
      <div class="field-pair">
        <label><span data-i18n="contrast.foreground">文字颜色</span><input type="color" value="#2F6DB3" data-color-picker="foreground" /></label>
        <label><span data-i18n="contrast.foreground">文字颜色</span> HEX<input type="text" value="#2F6DB3" data-color-hex="foreground" aria-describedby="contrast-error" spellcheck="false" /></label>
        <label><span data-i18n="contrast.background">背景颜色</span><input type="color" value="#FFFFFF" data-color-picker="background" /></label>
        <label><span data-i18n="contrast.background">背景颜色</span> HEX<input type="text" value="#FFFFFF" data-color-hex="background" aria-describedby="contrast-error" spellcheck="false" /></label>
      </div>
      <p id="contrast-error" role="alert" data-contrast-error hidden data-i18n="contrast.invalid">请输入有效的 3 位或 6 位十六进制颜色。</p>
      <label><Copy text={['预览文字','Preview text','Vorschautext']} /><input type="text" data-preview-text maxlength="300" value="Aa — The world, made clearer." /></label>
      <div class="field-pair"><label><Copy text={['字号（像素）','Font size (px)','Schriftgröße (px)']} /><input type="range" min="12" max="64" value="24" data-font-size /></label><label><Copy text={['字重','Font weight','Schriftstärke']} /><select data-font-weight><option value="400">400</option><option value="700">700</option></select></label></div>
      <Copy as="h3" text={['改善文字颜色','Improve text color','Textfarbe verbessern']} />
      <div class="suggestions"><button type="button" data-suggest="4.5">AA ≥ 4.5:1</button><button type="button" data-suggest="7">AAA ≥ 7:1</button></div>
      <p class="hint" data-suggestion-status></p>
      <Copy as="p" text={['建议会向黑或白调整当前文字颜色，选择变化较小的可用结果。','Suggestions move the text color toward black or white, choosing the smaller valid change.','Vorschläge passen die Textfarbe in Richtung Schwarz oder Weiß mit möglichst kleiner Änderung an.']} />
    </section>
    <section class="lab-panel">
      <header><b>02</b><Copy as="h2" text={['实时效果与标准','Live preview & thresholds','Vorschau & Grenzwerte']} /></header>
      <div class="contrast-preview" data-contrast-preview><h2 data-preview-heading>Aa — The world, made clearer.</h2><p>ABCDEFGHIJKLMNOPQRSTUVWXYZ<br />0123456789 · 世界编译局</p></div>
      <p class="contrast-ratio" data-contrast-ratio>—</p>
      <div class="contrast-results" aria-live="polite" data-contrast-results><p><span data-i18n="contrast.normal">普通文字</span><br />AA <b data-result="normalAA"></b> · AAA <b data-result="normalAAA"></b></p><p><span data-i18n="contrast.large">大号文字</span><br />AA <b data-result="largeAA"></b> · AAA <b data-result="largeAAA"></b></p></div>
      <p class="hint" data-i18n="contrast.note">此工具用于设计参考，不构成无障碍合规认证。</p>
    </section>
  </div>
  <section class="lab-panel contrast-audit" data-palette-audit>
    <header><b>03</b><div><Copy as="h2" text={['色板审查','Palette audit','Palettenprüfung']} /><Copy as="p" text={['逐对检查 2–12 个设计令牌，并查看文字、图标与控件示例。','Audit every pair in a 2–12 token palette with text, icon and control samples.','Alle Paare einer Palette mit 2–12 Farben samt Text-, Symbol- und Steuerelementbeispielen prüfen.']} /></div></header>
    <div class="contrast-audit-toolbar"><p data-palette-count aria-live="polite">6 个颜色 · 15 组配对</p><div><button type="button" data-token-add data-copy-zh="＋ 添加颜色" data-copy-en="＋ Add color" data-copy-de="＋ Farbe hinzufügen">＋ 添加颜色</button><button type="button" data-palette-export="json" data-copy-zh="导出 JSON" data-copy-en="Export JSON" data-copy-de="JSON exportieren">导出 JSON</button><button type="button" data-palette-export="html" data-copy-zh="导出 HTML 报告" data-copy-en="Export HTML report" data-copy-de="HTML-Bericht exportieren">导出 HTML 报告</button></div></div>
    <div class="contrast-token-list" data-token-list>
      {palette.map(([name, hex], index) => <div class="contrast-token" data-palette-token data-token-id={index}>
        <label><span data-copy-zh="令牌名称" data-copy-en="Token name" data-copy-de="Tokenname">令牌名称</span><input type="text" data-token-name value={name} maxlength="32" /></label>
        <label><span data-copy-zh="颜色" data-copy-en="Color" data-copy-de="Farbe">颜色</span><input type="color" data-token-picker value={hex} /></label>
        <label><span>HEX</span><input type="text" data-token-hex value={hex} maxlength="7" spellcheck="false" /></label>
        <button type="button" data-token-remove data-copy-zh="移除" data-copy-en="Remove" data-copy-de="Entfernen">移除</button>
      </div>)}
    </div>
    <template data-token-template><div class="contrast-token" data-palette-token>
      <label><span data-copy-zh="令牌名称" data-copy-en="Token name" data-copy-de="Tokenname">令牌名称</span><input type="text" data-token-name maxlength="32" /></label>
      <label><span data-copy-zh="颜色" data-copy-en="Color" data-copy-de="Farbe">颜色</span><input type="color" data-token-picker value="#2F6DB3" /></label>
      <label><span>HEX</span><input type="text" data-token-hex value="#2F6DB3" maxlength="7" spellcheck="false" /></label>
      <button type="button" data-token-remove data-copy-zh="移除" data-copy-en="Remove" data-copy-de="Entfernen">移除</button>
    </div></template>
    <p class="contrast-audit-error" role="alert" data-palette-error hidden data-copy-zh="请为每种颜色填写名称和有效的 3 位或 6 位 HEX 值。" data-copy-en="Give each color a name and a valid 3- or 6-digit HEX value." data-copy-de="Gib jeder Farbe einen Namen und einen gültigen 3- oder 6-stelligen HEX-Wert.">请为每种颜色填写名称和有效的 3 位或 6 位 HEX 值。</p>
    <p class="contrast-audit-summary" data-palette-summary></p>
    <div class="contrast-pair-list" data-palette-results></div>
    <p class="hint" data-copy-zh="AA/AAA 是设计检查辅助，实际合规还取决于字号、字重、状态、图形用途与真实界面。" data-copy-en="AA/AAA checks are design aids; actual conformance also depends on type size, weight, states, graphical purpose and the rendered interface." data-copy-de="AA/AAA-Prüfungen sind eine Designhilfe; die tatsächliche Konformität hängt auch von Schriftgröße, Gewicht, Zuständen, grafischem Zweck und der realen Oberfläche ab.">AA/AAA 是设计检查辅助，实际合规还取决于字号、字重、状态、图形用途与真实界面。</p>
  </section>
  <footer class="lab-export"><Copy as="p" text={['保留颜色、对比度与阈值结果，方便交付设计。','Keep colors, ratios and threshold results with your design handoff.','Farben, Verhältnisse und Grenzwerte für die Designübergabe speichern.']} /><button type="button" class="primary" data-contrast-download><Copy text={['下载配色报告','Download color report','Farbbericht herunterladen']} /></button></footer>
</section>
