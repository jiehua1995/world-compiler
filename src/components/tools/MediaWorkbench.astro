---
import Copy from '../Copy.astro';
const {slug}=Astro.props as {slug:string};
const stream=slug==='stream-studio', ocr=slug==='ocr-studio', text=slug==='pdf-text', images=slug==='image-pdf';
---
<section class="lab" data-lab={slug} data-media>
  <div class="lab-toolbar"><Copy text={['本地工作台 · 文件不上传','Local workbench · files are never uploaded','Lokale Werkbank · keine Datei-Uploads']} /></div>
  <div class="lab-grid">
    <div class="lab-panel">
      <header><b>01</b><Copy as="h2" text={['输入与设置','Input and settings','Eingabe und Einstellungen']} /></header>
      {stream ? <label><Copy text={['公开 M3U8 地址','Public M3U8 URL','Öffentliche M3U8-URL']} /><input data-url type="url" placeholder="https://example.org/video/index.m3u8" /></label> : <label><Copy text={['选择文件','Choose files','Dateien auswählen']} /><input data-files type="file" multiple={!ocr&&!text} accept={ocr||images?'image/png,image/jpeg':'.pdf,application/pdf'} /></label>}
      {stream && <Copy as="p" text={['仅支持允许跨域访问的未加密 MPEG-TS 点播。最多 2000 段、总计 128 MB。主播放列表、直播、DRM、字节范围及 fMP4 不受支持。请仅下载有权保存的内容。','Public CORS-enabled, unencrypted MPEG-TS VOD only. Maximum 2000 segments and 128 MB total. Master playlists, live streams, DRM, byte ranges and fMP4 are unsupported. Download only content you have permission to save.','Nur öffentliche, CORS-fähige, unverschlüsselte MPEG-TS-VODs. Maximal 2000 Segmente und 128 MB. Master-Playlists, Livestreams, DRM, Bytebereiche und fMP4 werden nicht unterstützt. Nur Inhalte mit Speicherberechtigung herunterladen.']} />}
      {ocr && <><label><Copy text={['识别语言','Recognition language','Erkennungssprache']} /><select data-language><option value="eng">English</option><option value="deu">Deutsch</option><option value="chi_sim">简体中文</option></select></label><div class="field-pair"><label><Copy text={['旋转校正','Rotation correction','Drehkorrektur']} /><select data-rotation><option value="0">0°</option><option value="90">90°</option><option value="180">180°</option><option value="270">270°</option></select></label><label><Copy text={['图像增强','Image enhancement','Bildverbesserung']} /><select data-enhance><option value="none" data-copy-zh="原图" data-copy-en="Original" data-copy-de="Original">原图</option><option value="gray" data-copy-zh="灰度" data-copy-en="Grayscale" data-copy-de="Graustufen">灰度</option><option value="contrast" data-copy-zh="灰度 + 高对比度" data-copy-en="Grayscale + high contrast" data-copy-de="Graustufen + hoher Kontrast">灰度 + 高对比度</option></select></label></div><button data-prepare type="button"><Copy text={['首次下载语言和引擎','Download language and engine','Sprache und Engine herunterladen']} /></button><p data-ready role="status"></p><Copy as="p" text={['首次使用需下载本站托管的语言包和引擎（约 5–30 MB）；缓存后当前工作台可离线识别。预处理完全在本机运行。图片不上传，结果请人工核对。仅 PNG/JPEG，最大 20 MB、3200 万像素。','First use downloads this site’s language and engine assets (about 5–30 MB). Once cached, this open workbench can recognize offline. Preprocessing stays on-device. Images are never uploaded; review results. PNG/JPEG only; 20 MB and 32 million pixels maximum.','Beim ersten Start werden Sprach- und Engine-Dateien von dieser Website geladen (ca. 5–30 MB). Nach dem Zwischenspeichern funktioniert diese geöffnete Werkbank offline. Die Vorverarbeitung bleibt lokal. Bilder werden nie hochgeladen; Ergebnisse prüfen. Nur PNG/JPEG, maximal 20 MB und 32 Millionen Pixel.']} /></>}
      {!stream&&!ocr&&!images && <label><Copy text={['页码（留空为全部；例如 1-3,5）','Pages (blank for all; e.g. 1-3,5)','Seiten (leer für alle; z. B. 1-3,5)']} /><input data-range placeholder="1-3,5" /></label>}
      {slug==='pdf-desk' && <Copy as="p" text={['文件按列表顺序合并；页码范围分别应用于每个文件。最多 20 个文件、总计 64 MB、2000 页。不支持加密文件；表单、书签与签名可能丢失。','Files merge in the order below; the range applies to each file. Maximum 20 files, 64 MB total, 2000 pages. Encrypted PDFs are unsupported; forms, bookmarks and signatures may not survive.','Dateien werden in der folgenden Reihenfolge zusammengeführt; der Bereich gilt je Datei. Maximal 20 Dateien, insgesamt 64 MB und 2000 Seiten. Verschlüsselte PDFs werden nicht unterstützt; Formulare, Lesezeichen und Signaturen bleiben eventuell nicht erhalten.']} />}
      {text && <Copy as="p" text={['提取已有文字层，保留分页标记；扫描件请使用 OCR。阅读顺序取决于 PDF。最大 32 MB、2000 页。','Extract existing text with page markers; use OCR for scanned pages. Reading order depends on the PDF. Maximum 32 MB and 2000 pages.','Vorhandenen Text mit Seitenmarkierungen extrahieren; für Scans OCR verwenden. Die Lesereihenfolge hängt vom PDF ab. Maximal 32 MB und 2000 Seiten.']} />}
      {images && <label><Copy text={['页面大小','Page size','Seitengröße']} /><select data-size><option value="a4">A4</option><option value="letter">US Letter</option><option value="image">Image size / Bildgröße / 原图尺寸</option></select><Copy as="p" text={['按列表顺序创建，每页一张 PNG/JPEG，等比居中。最多 20 张、总计 64 MB，每张不超过 3200 万像素。','One PNG/JPEG per page in the order below, centered without stretching. Maximum 20 images, 64 MB total, 32 million pixels per image.','Ein PNG/JPEG je Seite in der folgenden Reihenfolge, zentriert ohne Verzerrung. Maximal 20 Bilder, insgesamt 64 MB, 32 Millionen Pixel je Bild.']} /></label>}
      <ol data-list></ol>
      <div class="lab-actions"><button data-run type="button" class="primary"><Copy text={stream?['检查播放列表','Inspect playlist','Playlist prüfen']:['处理文件','Process files','Dateien verarbeiten']} /></button>{stream&&<button data-download type="button" disabled><Copy text={['下载 TS','Download TS','TS herunterladen']} /></button>}<button data-cancel type="button" disabled><Copy text={['取消','Cancel','Abbrechen']} /></button></div>
    </div>
    <div class="lab-panel"><header><b>02</b><Copy as="h2" text={['结果','Result','Ergebnis']} /></header><p data-status role="status" aria-live="polite"></p><progress data-progress max="1" value="0" aria-label="处理进度" data-label-zh="处理进度" data-label-en="Processing progress" data-label-de="Verarbeitungsfortschritt"></progress><textarea data-output readonly aria-label="结果" data-label-zh="结果" data-label-en="Result" data-label-de="Ergebnis"></textarea>{ocr&&<section class="ocr-lines" data-line-results hidden><h3><Copy text={['逐行置信度（仅供参考）','Line confidence (indicative only)','Zeilenkonfidenz (nur Richtwert)']} /></h3><Copy as="p" text={['这是 OCR 引擎的相对评分，不是正确率或概率保证。','This is the OCR engine’s relative score, not a probability or accuracy guarantee.','Dies ist ein relativer Engine-Wert, keine Genauigkeits- oder Wahrscheinlichkeitsgarantie.']} /><ol data-lines aria-live="polite"></ol></section>}<div class="lab-actions"><button data-copy type="button"><Copy text={['复制文本','Copy text','Text kopieren']} /></button><button data-save type="button" disabled><Copy text={['保存结果','Save result','Ergebnis speichern']} /></button></div></div>
  </div>
</section>
<script>
  import {mount} from '../../features/media-tools/controller';
  document.querySelectorAll<HTMLElement>('[data-media]').forEach(root=>{const cleanup=mount(root);window.addEventListener('pagehide',cleanup,{once:true});});
</script>
