<section class="export-panel" aria-labelledby="export-title">
  <div>
    <p class="section-kicker" data-copy-zh="OUTPUT / 本地导出" data-copy-en="OUTPUT / Local export" data-copy-de="OUTPUT / Lokaler Export">OUTPUT / 本地导出</p>
    <h2 id="export-title" data-i18n="cv.exportTitle">导出结果</h2>
  </div>
  <div class="export-panel__controls">
    <label>
      <span data-i18n="cv.exportFormat">导出格式</span>
      <select data-export-format disabled>
        <option value="image/png">PNG</option>
        <option value="image/jpeg">JPEG</option>
      </select>
    </label>
    <label data-quality-row hidden>
      <span data-i18n="cv.exportQuality">JPEG 质量</span>
      <input type="range" min="0.5" max="1" step="0.05" value="0.9" data-export-quality disabled />
    </label>
  </div>
</section>
