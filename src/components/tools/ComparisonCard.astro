---
import type { VisionMode } from '../../features/color-vision/types';
interface Props { variant: VisionMode; index: number; name: string; nameEn: string; nameDe: string; }
const { variant, index, name, nameEn, nameDe } = Astro.props;
---

<article class="comparison-card" data-comparison-card={variant}>
  <header>
    <span class="comparison-card__index">{String(index).padStart(2, '0')}</span>
    <h2
      data-copy-zh={name}
      data-copy-en={nameEn}
      data-copy-de={nameDe}
    >{name}</h2>
  </header>
  <div class="comparison-card__viewport">
    <canvas
      data-canvas={variant}
      role="img"
      aria-label={name}
    ></canvas>
    <div class="comparison-card__waiting" data-preview-placeholder>
      <span aria-hidden="true"></span>
    </div>
  </div>
  <button
    type="button"
    data-preview-target={variant}
    aria-label={name}
    disabled
  >
    <span data-i18n="cv.inspect">放大查看</span><b aria-hidden="true">↗</b>
  </button>
  <button type="button" data-export-mode={variant} data-export disabled aria-label={name}>
    <span data-i18n="cv.exportButton">导出此模式</span><b aria-hidden="true">↓</b>
  </button>
</article>
