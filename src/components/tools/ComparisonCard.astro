---
interface Props { variant: 'original' | 'simulation'; name: string; nameEn: string; nameDe: string; }
const { variant, name, nameEn, nameDe } = Astro.props;
---

<article class="comparison-card" data-comparison-card={variant}>
  <header>
    <span class="comparison-card__index">{variant === 'original' ? '01' : '02'}</span>
    <h2
      data-copy-zh={name}
      data-copy-en={nameEn}
      data-copy-de={nameDe}
      data-simulation-title={variant === 'simulation' ? true : undefined}
    >{name}</h2>
  </header>
  <div class="comparison-card__viewport">
    <canvas
      data-canvas={variant}
      role="img"
      aria-label={name}
    ></canvas>
    <div class="comparison-card__waiting" data-preview-placeholder>
      <span aria-hidden="true"></span>
    </div>
  </div>
  <button
    type="button"
    data-preview-target={variant}
    aria-label={name}
    disabled
  >
    <span data-i18n="cv.inspect">放大查看</span><b aria-hidden="true">↗</b>
  </button>
</article>
