---
import Copy from '../Copy.astro';
---
<section class="lab" data-lab="image-studio"><div class="lab-grid"><section class="lab-panel">
<header><b>01</b><Copy as="h2" text={["图片与变换","Image & transforms","Bild & Bearbeitung"]} /></header>
<label><Copy as="span" text={["选择本地图片","Choose a local image","Lokales Bild wählen"]} /><input type="file" accept="image/png,image/jpeg,image/webp" data-image-file /></label>
<div class="field-pair"><label><Copy as="span" text={["输出宽度（像素）","Output width (px)","Ausgabebreite (px)"]} /><input type="number" data-image-width min="1" max="8192" step="1" value="1200" /></label><label><Copy as="span" text={["输出高度（像素）","Output height (px)","Ausgabehöhe (px)"]} /><input type="number" data-image-height min="1" max="8192" step="1" value="800" /></label></div>
<label class="check"><input type="checkbox" data-image-lock checked /><Copy as="span" text={["锁定宽高比","Lock aspect ratio","Seitenverhältnis sperren"]} /></label>
<div class="field-pair"><label><Copy as="span" text={["中心裁剪","Center crop","Mittiger Zuschnitt"]} /><select data-image-crop><option value="original" data-copy-zh="原始比例" data-copy-en="Original ratio" data-copy-de="Originalverhältnis">原始比例</option><option value="1">1:1</option><option value="1.3333333333333333">4:3</option><option value="1.7777777777777777">16:9</option><option value="0.6666666666666666">2:3</option></select></label><label><Copy as="span" text={["旋转","Rotation","Drehung"]} /><select data-image-rotate><option value="0">0°</option><option value="90">90°</option><option value="180">180°</option><option value="270">270°</option></select></label></div>
<label class="check"><input type="checkbox" data-image-flip /><Copy as="span" text={["水平翻转","Flip horizontally","Horizontal spiegeln"]} /></label>
<div class="field-pair"><label><Copy as="span" text={["输出格式","Output format","Ausgabeformat"]} /><select data-image-format><option value="image/webp">WebP</option><option value="image/jpeg">JPEG</option><option value="image/png">PNG</option></select></label><label><Copy as="span" text={["质量（10–100）","Quality (10–100)","Qualität (10–100)"]} /><input type="range" data-image-quality min="10" max="100" value="85" /></label></div>
<p class="hint"><Copy as="span" text={["PNG 保留透明度；JPEG 使用白色背景。最多导入 20 MB / 32 MP，输出限制 16 MP、最长边 8192 像素。","PNG preserves transparency; JPEG uses a white background. Input: 20 MB / 32 MP. Output: 16 MP, max edge 8192 px.","PNG behält Transparenz; JPEG nutzt weißen Hintergrund. Eingabe: 20 MB / 32 MP. Ausgabe: 16 MP, längste Kante 8192 px."]} /></p>
<p role="alert" data-tool-error hidden></p>
</section><section class="lab-panel"><header><b>02</b><Copy as="h2" text={["导出预览","Export preview","Exportvorschau"]} /></header><div class="image-stage"><canvas width="0" height="0" data-image-canvas></canvas></div><p role="status" data-tool-status></p><div class="stat-strip"><p><Copy as="span" text={["原始大小","Source size","Originalgröße"]} /><strong data-image-source>—</strong></p><p><Copy as="span" text={["导出大小","Export size","Exportgröße"]} /><strong data-image-result>—</strong></p></div></section></div><footer class="lab-export"><Copy as="p" text={["重编码只输出像素，不复制原文件的 EXIF 元数据。","Re-encoding exports pixels without copying source EXIF metadata.","Neukodierung exportiert Pixel ohne EXIF-Metadaten der Quelldatei."]} /><div class="lab-actions"><button type="button" data-image-download disabled class="primary"><Copy as="span" text={["下载图片","Download image","Bild herunterladen"]} /></button></div></footer></section>
