<div class="drop-zone" data-drop-zone>
  <input
    id="image-input"
    class="visually-hidden"
    type="file"
    accept="image/png,image/jpeg,image/webp,image/gif"
    data-image-input
    aria-label="选择本地图片"
    data-label-zh="选择本地图片"
    data-label-en="Choose a local image"
  />
  <label for="image-input">
    <span class="drop-zone__icon" aria-hidden="true">＋</span>
    <strong data-i18n="cv.dropTitle">把图片拖到这里</strong>
    <span data-i18n="cv.dropHint">或点击选择 PNG、JPEG、WebP、GIF</span>
    <b data-i18n="cv.choose">选择本地图片</b>
  </label>
</div>
