---
import Copy from '../Copy.astro';
---
<section class="lab" data-lab="json-studio"><div class="lab-toolbar"><button type="button" data-json-sample class=""><Copy as="span" text={["载入示例","Load example","Beispiel laden"]} /></button><label><Copy as="span" text={["缩进","Indentation","Einrückung"]} /><select data-json-indent><option value="2">2</option><option value="4">4</option><option value="0" data-copy-zh="压缩" data-copy-en="Minify" data-copy-de="Komprimieren">压缩</option></select></label><button type="button" data-json-run class="primary"><Copy as="span" text={["校验并格式化","Validate & format","Prüfen & formatieren"]} /></button><button type="button" data-json-copy disabled class=""><Copy as="span" text={["复制结果","Copy result","Ergebnis kopieren"]} /></button></div>
<div class="lab-grid"><section class="lab-panel"><header><b>01</b><Copy as="h2" text={["JSON 输入","JSON input","JSON-Eingabe"]} /></header><label><Copy as="span" text={["JSON 输入","JSON input","JSON-Eingabe"]} /><textarea maxlength="1000000" data-json-input spellcheck="false"></textarea></label><label><Copy as="span" text={["导入 JSON 文件（最多 1 MB）","Import JSON file (up to 1 MB)","JSON-Datei importieren (bis 1 MB)"]} /><input type="file" accept=".json,application/json" data-json-file /></label><p role="alert" data-tool-error hidden></p><p role="status" data-tool-status></p></section><section class="lab-panel"><header><b>02</b><Copy as="h2" text={["格式化与结构","Formatted & structured","Format & Struktur"]} /></header><span class="output-caption"><Copy text={["格式化输出","Formatted output","Formatierte Ausgabe"]} /></span><pre class="lab-output" data-json-output tabindex="0"></pre><h3><Copy as="span" text={["可折叠结构（前 300 个节点）","Collapsible tree (first 300 nodes)","Aufklappbarer Baum (erste 300 Knoten)"]} /></h3><div data-json-tree></div></section></div><footer class="lab-export"><Copy as="p" text={["使用 JavaScript 数值语义。超出安全整数范围的数值可能失去精度。","Uses JavaScript number semantics. Numbers outside the safe integer range may lose precision.","Verwendet JavaScript-Zahlen. Werte außerhalb des sicheren Ganzzahlbereichs können Genauigkeit verlieren."]} /><div class="lab-actions"><button type="button" data-json-download disabled class="primary"><Copy as="span" text={["下载 JSON","Download JSON","JSON herunterladen"]} /></button></div></footer></section>
