---
import Copy from '../Copy.astro';
---
<section class="lab" data-lab="qr-studio"><div class="lab-grid"><section class="lab-panel"><header><b>01</b><Copy as="h2" text={["内容与样式","Content & style","Inhalt & Stil"]} /></header>
<label><Copy as="span" text={["内容类型","Content type","Inhaltstyp"]} /><select data-qr-type><option value="text" data-copy-zh="文本 / 网址" data-copy-en="Text / URL" data-copy-de="Text / URL">文本 / 网址</option><option value="wifi">Wi-Fi</option></select></label>
<label data-qr-text-row><Copy as="span" text={["文本或网址","Text or URL","Text oder URL"]} /><textarea maxlength="1500" data-qr-text>https://jiehua1995.github.io/world-compiler/</textarea></label>
<div data-qr-wifi hidden><label><Copy as="span" text={["网络名称（SSID）","Network name (SSID)","Netzwerkname (SSID)"]} /><input type="text" data-qr-ssid maxlength="100" value="" /></label><label><Copy as="span" text={["Wi-Fi 密码","Wi-Fi password","WLAN-Passwort"]} /><input type="password" data-qr-password maxlength="150" value="" /></label><label><Copy as="span" text={["加密方式","Security","Verschlüsselung"]} /><select data-qr-security><option>WPA</option><option>WEP</option><option value="nopass" data-copy-zh="开放网络" data-copy-en="Open network" data-copy-de="Offenes Netzwerk">开放网络</option></select></label><label class="check"><input type="checkbox" data-qr-hidden /><Copy as="span" text={["隐藏网络","Hidden network","Verborgenes Netzwerk"]} /></label></div>
<div class="field-pair"><label><Copy as="span" text={["码点颜色","Code color","Codefarbe"]} /><input type="color" data-qr-dark value="#101a27" /></label><label><Copy as="span" text={["背景颜色","Background color","Hintergrundfarbe"]} /><input type="color" data-qr-light value="#ffffff" /></label></div>
<div class="field-pair"><label><Copy as="span" text={["纠错等级","Error correction","Fehlerkorrektur"]} /><select data-qr-level><option>L</option><option selected>M</option><option>Q</option><option>H</option></select></label><label><Copy as="span" text={["留白（模块）","Margin (modules)","Rand (Module)"]} /><input type="number" data-qr-margin min="4" max="12" value="4" /></label></div>
<p class="hint"><Copy as="span" text={["生成后请用手机测试。Wi-Fi 二维码包含密码，导出或分享时注意内容。","Test with a phone after generation. Wi-Fi QR codes include the password; share them thoughtfully.","Nach dem Erzeugen mit einem Telefon testen. WLAN-QR-Codes enthalten das Passwort."]} /></p><p role="alert" data-tool-error hidden></p>
</section><section class="lab-panel"><header><b>02</b><Copy as="h2" text={["扫码预览","Scan preview","Scanvorschau"]} /></header><div class="image-stage"><canvas data-qr-canvas width="0" height="0"></canvas></div><p role="status" data-tool-status></p></section></div><footer class="lab-export"><Copy as="p" text={["所有处理均在当前浏览器中完成。","All processing stays in this browser.","Alles wird in diesem Browser verarbeitet."]} /><div class="lab-actions"><button type="button" data-qr-png disabled class=""><Copy as="span" text={["下载 PNG","Download PNG","PNG herunterladen"]} /></button><button type="button" data-qr-svg disabled class="primary"><Copy as="span" text={["下载 SVG","Download SVG","SVG herunterladen"]} /></button></div></footer></section>
