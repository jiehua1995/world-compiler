---
import Copy from '../Copy.astro';
---
<section class="lab" data-lab="text-diff"><div class="lab-toolbar"><button type="button" data-diff-sample class=""><Copy as="span" text={["载入示例","Load example","Beispiel laden"]} /></button><button type="button" data-diff-swap class=""><Copy as="span" text={["交换文本","Swap texts","Texte tauschen"]} /></button><label class="check"><input type="checkbox" data-diff-space /><Copy as="span" text={["忽略行首尾空白","Ignore line-edge whitespace","Leerraum am Zeilenrand ignorieren"]} /></label><label class="check"><input type="checkbox" data-diff-case /><Copy as="span" text={["忽略大小写","Ignore case","Groß-/Kleinschreibung ignorieren"]} /></label><label><Copy as="span" text={["比较单位","Compare by","Vergleichen nach"]} /><select data-diff-mode><option value="lines" data-copy-zh="行" data-copy-en="Line" data-copy-de="Zeile">行</option><option value="words" data-copy-zh="词" data-copy-en="Word" data-copy-de="Wort">词</option></select></label><button type="button" data-diff-run class="primary"><Copy as="span" text={["比较文本","Compare texts","Texte vergleichen"]} /></button></div>
<div class="lab-grid"><section class="lab-panel"><header><b>01</b><Copy as="h2" text={["原始文本","Original text","Originaltext"]} /></header><label><Copy as="span" text={["原始文本","Original text","Originaltext"]} /><textarea data-diff-before maxlength="50000"></textarea></label><div class="lab-output" data-diff-left></div></section><section class="lab-panel"><header><b>02</b><Copy as="h2" text={["修改文本","Modified text","Geänderter Text"]} /></header><label><Copy as="span" text={["修改文本","Modified text","Geänderter Text"]} /><textarea data-diff-after maxlength="50000"></textarea></label><div class="lab-output" data-diff-right></div></section></div>
<div class="lab-toolbar"><p role="status" data-tool-status></p><p role="alert" data-tool-error hidden></p><button type="button" data-diff-prev disabled class=""><Copy as="span" text={["← 上一处修改","← Previous change","← Vorherige Änderung"]} /></button><button type="button" data-diff-next disabled class=""><Copy as="span" text={["下一处修改 →","Next change →","Nächste Änderung →"]} /></button></div>
<footer class="lab-export"><Copy as="p" text={["每侧最多 50,000 个字符。修改输入后需重新比较；忽略项作用于比较结果。","Up to 50,000 characters per side. Recompare after edits; ignored options normalize comparison output.","Bis zu 50.000 Zeichen pro Seite. Nach Änderungen erneut vergleichen; ignorierte Merkmale normalisieren die Ausgabe."]} /><div class="lab-actions"><button type="button" data-diff-download disabled class="primary"><Copy as="span" text={["下载差异报告","Download diff report","Vergleich herunterladen"]} /></button></div></footer></section>
