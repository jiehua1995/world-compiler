<section class="palette-workbench" data-palette-workbench aria-labelledby="palette-title">
  <header class="palette-workbench__heading"><div><p class="section-kicker" data-copy-zh="PALETTE / 本地配色工作台" data-copy-en="PALETTE / Local color studio" data-copy-de="PALETTE / Lokales Farbstudio">PALETTE / 本地配色工作台</p><h2 id="palette-title" data-copy-zh="色板设计与色觉检查" data-copy-en="Palette design & vision check" data-copy-de="Palettendesign & Sehprüfung">色板设计与色觉检查</h2></div><p data-copy-zh="从图片提取、按色彩关系生成，或逐色编辑。每种视觉模式下的色板会同步预览。" data-copy-en="Extract from an image, generate by color harmony, or edit each swatch. Every vision mode is previewed together." data-copy-de="Aus einem Bild extrahieren, nach Farbharmonie erzeugen oder Farben einzeln bearbeiten. Alle Sehmodi werden parallel verglichen。">从图片提取、按色彩关系生成，或逐色编辑。每种视觉模式下的色板会同步预览。</p></header>
  <div class="palette-controls">
    <label><span data-copy-zh="基础色" data-copy-en="Base color" data-copy-de="Grundfarbe">基础色</span><input type="color" value="#FCA104" data-palette-base /></label>
    <label><span data-copy-zh="颜色数量（2–12）" data-copy-en="Number of colors (2–12)" data-copy-de="Farbanzahl (2–12)">颜色数量（2–12）</span><input type="number" min="2" max="12" value="6" data-palette-count /></label>
    <label><span data-copy-zh="配色关系" data-copy-en="Harmony" data-copy-de="Farbharmonie">配色关系</span><select data-palette-harmony><option value="complementary">Complementary / 互补</option><option value="analogous">Analogous / 类似</option><option value="triadic">Triadic / 三角色</option><option value="split-complementary">Split complementary / 分裂互补</option><option value="monochromatic">Monochromatic / 单色</option></select></label>
    <button type="button" data-palette-generate data-copy-zh="生成配色" data-copy-en="Generate harmony" data-copy-de="Harmonie erzeugen">生成配色</button>
    <label><span data-copy-zh="预设色板" data-copy-en="Curated palettes" data-copy-de="Vorgestellte Paletten">预设色板</span><select data-palette-preset><option value="brand">World Compiler / 品牌色</option><option value="ocean">Ocean / 海洋</option><option value="sunset">Sunset / 日落</option><option value="forest">Forest / 森林</option><option value="accessible">Accessible basics / 无障碍基础色</option></select></label>
    <button type="button" data-palette-apply-preset data-copy-zh="使用预设" data-copy-en="Use palette" data-copy-de="Palette verwenden">使用预设</button>
    <button type="button" data-palette-extract disabled data-copy-zh="从已导入图片提取" data-copy-en="Extract from imported image" data-copy-de="Aus importiertem Bild extrahieren">从已导入图片提取</button>
    <button type="button" data-palette-add data-copy-zh="＋ 添加颜色" data-copy-en="＋ Add color" data-copy-de="＋ Farbe hinzufügen">＋ 添加颜色</button>
    <button type="button" data-palette-sample disabled data-copy-zh="从原图点击取样" data-copy-en="Click original to sample" data-copy-de="Zum Aufnehmen Original anklicken">从原图点击取样</button>
    <button type="button" data-palette-export="json" data-copy-zh="导出 JSON" data-copy-en="Export JSON" data-copy-de="JSON exportieren">导出 JSON</button>
    <button type="button" data-palette-export="css" data-copy-zh="导出 CSS 变量" data-copy-en="Export CSS tokens" data-copy-de="CSS-Variablen exportieren">导出 CSS 变量</button>
  </div>
  <p class="palette-status" data-palette-status aria-live="polite" data-copy-zh="可先导入图片，或从预设开始。" data-copy-en="Import an image or start with a preset." data-copy-de="Importiere ein Bild oder beginne mit einer Palette.">可先导入图片，或从预设开始。</p>
  <div class="palette-swatches" data-palette-swatches></div>
  <div class="palette-preview-grid" data-palette-previews></div>
  <section class="palette-contrast" aria-labelledby="palette-contrast-title"><div><p class="section-kicker" data-copy-zh="PAIR / 颜色对比" data-copy-en="PAIR / Color contrast" data-copy-de="PAAR / Farbkontrast">PAIR / 颜色对比</p><h3 id="palette-contrast-title" data-copy-zh="检查一组文字与背景" data-copy-en="Check a text and background pair" data-copy-de="Text- und Hintergrundpaar prüfen">检查一组文字与背景</h3></div><label><span data-copy-zh="前景 / 文字" data-copy-en="Foreground / text" data-copy-de="Vordergrund / Text">前景 / 文字</span><select data-palette-foreground></select></label><label><span data-copy-zh="背景" data-copy-en="Background" data-copy-de="Hintergrund">背景</span><select data-palette-background></select></label><div class="palette-contrast-results" data-palette-contrast-results></div></section>
</section>
