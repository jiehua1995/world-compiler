---
import Copy from '../Copy.astro';
---
<section class="lab" data-data-shaper>
  <div class="lab-toolbar"><button type="button" data-data-sample><Copy text={['载入示例','Load example','Beispiel laden']} /></button><p role="status" aria-live="polite" data-data-status data-i18n="data.status.empty">等待选择表格文件</p></div>
  <div class="lab-grid">
    <section class="lab-panel">
      <header><b>01</b><Copy as="h2" text={['数据与转换','Data & transforms','Daten & Umformung']} /></header>
      <div class="field-pair">
        <label><span data-i18n="data.delimiter">分隔符</span><select data-delimiter><option value="," data-i18n="data.csv">逗号（CSV）</option><option value="tab" data-i18n="data.tsv">制表符（TSV）</option></select></label>
        <label><span data-i18n="data.file">选择 CSV 或 TSV 文件</span><input type="file" accept=".csv,.tsv,text/csv,text/tab-separated-values" data-data-file /></label>
      </div>
      <label><Copy text={['或粘贴表格内容','Or paste a table','Oder Tabellendaten einfügen']} /><textarea data-data-paste maxlength="1000000" rows="6"></textarea></label>
      <button type="button" data-data-read><Copy text={['读取粘贴内容','Read pasted data','Eingefügte Daten lesen']} /></button>
      <hr />
      <label><Copy text={['保留列：序号用逗号分隔，留空保留全部','Keep columns: comma-separated numbers; blank keeps all','Spalten behalten: Nummern mit Komma; leer = alle']} /><input type="text" data-keep-columns placeholder="1,3,2" /></label>
      <label><Copy text={['新列名：CSV 格式，留空使用原名','New column names: CSV; blank keeps originals','Neue Spaltennamen: CSV; leer = unverändert']} /><input type="text" data-column-names /></label>
      <div class="field-pair"><label><Copy text={['排序后的列序号','Column number to sort','Spaltennummer zum Sortieren']} /><input type="number" min="1" step="1" value="1" data-sort-column /></label><label><Copy text={['排序方式','Sort order','Sortierung']} /><select data-sort-order><option value="none" data-copy-zh="不排序" data-copy-en="Keep order" data-copy-de="Reihenfolge behalten">不排序</option><option value="asc" data-copy-zh="升序" data-copy-en="Ascending" data-copy-de="Aufsteigend">升序</option><option value="desc" data-copy-zh="降序" data-copy-en="Descending" data-copy-de="Absteigend">降序</option></select></label></div>
      <label class="check"><input type="checkbox" data-deduplicate /><Copy text={['移除重复数据行（首行为表头）','Remove duplicate data rows (first row is header)','Doppelte Datenzeilen entfernen (erste Zeile = Kopfzeile)']} /></label>
      <button type="button" class="primary" data-clean disabled data-i18n="data.clean">清理单元格并移除空白行</button>
      <p role="alert" data-data-error hidden></p>
    </section>
    <section class="lab-panel">
      <header><b>02</b><Copy as="h2" text={['预览与结构检查','Preview & structure','Vorschau & Struktur']} /></header>
      <div class="stat-strip"><p><Copy text={['原始行数（含表头）','Source rows (with header)','Quellzeilen (mit Kopfzeile)']} /><strong data-source-count>0</strong></p><p><Copy text={['结果行数','Result rows','Ergebniszeilen']} /><strong data-result-count>0</strong></p><p><Copy text={['空单元格','Empty cells','Leere Zellen']} /><strong data-empty-count>0</strong></p></div>
      <p class="hint" data-ragged></p>
      <section data-data-preview hidden aria-labelledby="data-workbench-title"><h2 id="data-workbench-title" data-i18n="data.preview">数据预览</h2><div class="data-table-wrap"><table><caption class="visually-hidden" data-i18n="data.preview">数据预览</caption><tbody data-data-table></tbody></table></div></section>
      <Copy as="p" text={['预览前 8 行、30 列。文件上限 10 MB、250,000 个单元格；粘贴上限 1,000,000 个字符。原始输入始终保留，重复清理不会叠加修改。','Preview: first 8 rows and 30 columns. Files: 10 MB / 250,000 cells; pasted text: 1,000,000 characters. Transforms always start from the original input.','Vorschau: erste 8 Zeilen und 30 Spalten. Dateien: 10 MB / 250.000 Zellen; eingefügter Text: 1.000.000 Zeichen. Änderungen starten immer von den Originaldaten.']} />
    </section>
  </div>
  <footer class="lab-export"><div><label class="check"><input type="checkbox" data-formula-safe /><Copy text={['在公式样式单元格前加单引号，降低电子表格执行公式风险','Prefix formula-like cells with an apostrophe for spreadsheet safety','Formelähnlichen Zellen ein Apostroph für Tabellenkalkulationen voranstellen']} /></label><Copy as="p" text={['此选项会改变对应单元格文本。','This option changes the affected cell values.','Diese Option verändert betroffene Zellwerte.']} /></div><div class="lab-actions"><label><Copy text={['导出格式','Export format','Exportformat']} /><select data-data-format><option>CSV</option><option>TSV</option><option>JSON</option></select></label><button type="button" class="primary" data-download disabled data-i18n="data.download">下载整理后的 CSV</button></div></footer>
</section>
