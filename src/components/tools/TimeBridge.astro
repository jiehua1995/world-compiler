---
import Copy from '../Copy.astro';
---
<section class="lab" data-lab="time-bridge"><div class="lab-toolbar"><button type="button" data-time-now class=""><Copy as="span" text={["使用当前时间","Use current time","Aktuelle Zeit verwenden"]} /></button></div><div class="lab-grid"><section class="lab-panel"><header><b>01</b><Copy as="h2" text={["时间输入","Time input","Zeiteingabe"]} /></header>
<label><Copy as="span" text={["输入方式","Input type","Eingabetyp"]} /><select data-time-type><option value="seconds" data-copy-zh="Unix 秒" data-copy-en="Unix seconds" data-copy-de="Unix-Sekunden">Unix 秒</option><option value="milliseconds" data-copy-zh="Unix 毫秒" data-copy-en="Unix milliseconds" data-copy-de="Unix-Millisekunden">Unix 毫秒</option><option value="iso" data-copy-zh="ISO 日期（须包含时区）" data-copy-en="ISO date (time zone required)" data-copy-de="ISO-Datum (mit Zeitzone)">ISO 日期（须包含时区）</option></select></label>
<label><Copy as="span" text={["时间值","Time value","Zeitwert"]} /><input type="text" data-time-input value="0" /></label>
<label><Copy as="span" text={["显示时区","Display time zone","Anzeigezeitzone"]} /><select data-time-zone><option>UTC</option><option>Europe/Berlin</option><option>Asia/Shanghai</option><option>America/New_York</option><option>Asia/Tokyo</option><option>Australia/Sydney</option></select></label>
<p class="hint"><Copy as="span" text={["ISO 示例：2026-10-15T12:00:00+02:00。带时区的输入可避免夏令时歧义。","ISO example: 2026-10-15T12:00:00+02:00. Include a time-zone offset to avoid daylight-saving ambiguity.","ISO-Beispiel: 2026-10-15T12:00:00+02:00. Eine Zeitzonenangabe vermeidet Sommerzeit-Mehrdeutigkeit."]} /></p><p role="alert" data-tool-error hidden></p>
</section><section class="lab-panel"><header><b>02</b><Copy as="h2" text={["转换结果","Converted time","Umgewandelte Zeit"]} /></header><div class="stat-strip"><p><Copy as="span" text={["Unix 秒","Unix seconds","Unix-Sekunden"]} /><strong data-time-seconds>0</strong></p><p><Copy as="span" text={["Unix 毫秒","Unix milliseconds","Unix-Millisekunden"]} /><strong data-time-ms>0</strong></p></div><h3>ISO 8601 / UTC</h3><p class="lab-output" data-time-iso></p><h3><Copy as="span" text={["所选时区","Selected time zone","Ausgewählte Zeitzone"]} /></h3><p class="lab-output" data-time-local></p><p role="status" data-tool-status></p></section></div><footer class="lab-export"><Copy as="p" text={["所有处理均在当前浏览器中完成。","All processing stays in this browser.","Alles wird in diesem Browser verarbeitet."]} /><div class="lab-actions"><button type="button" data-time-copy class="primary"><Copy as="span" text={["复制时间信息","Copy time details","Zeitangaben kopieren"]} /></button></div></footer></section>
