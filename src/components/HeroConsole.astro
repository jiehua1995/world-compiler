---
import { tools } from '../data/tools';
const count = tools.filter(tool => tool.status === 'available').length;
---
<section class="hero-console" aria-labelledby="home-heading" data-clock>
  <div class="hero-console__copy">
    <p class="hero-console__eyebrow" data-i18n="home.eyebrow">WC / 公共工具协议 001</p>
    <h1 id="home-heading" data-i18n="home.heading">把复杂世界，编译成可用工具。</h1>
    <p class="hero-console__lede" data-i18n="home.intro">无需登录，也不上传你的数据。世界编译局把专业能力封装成清晰、可信、在浏览器本地运行的工具。</p>
  </div>
  <div class="hero-console__scope">
    <svg class="observatory-clock" viewBox="0 0 400 400" aria-hidden="true">
      <circle class="clock-halo" cx="200" cy="200" r="178" />
      <circle class="clock-orbit" cx="200" cy="200" r="146" />
      <circle class="clock-orbit clock-orbit--inner" cx="200" cy="200" r="91" />
      {Array.from({length:60}, (_, i) => <line class={i % 5 === 0 ? 'clock-tick clock-tick--major' : 'clock-tick'} x1="200" x2="200" y1={i % 5 === 0 ? '53' : '58'} y2="66" transform={`rotate(${i*6} 200 200)`} />)}
      {[12,3,6,9].map((n,i) => <text x={[200,322,200,78][i]} y={[90,205,326,205][i]} class="clock-number">{String(n).padStart(2,'0')}</text>)}
      <line class="clock-hand clock-hand--hour" x1="200" y1="211" x2="200" y2="121" />
      <line class="clock-hand clock-hand--minute" x1="200" y1="217" x2="200" y2="87" />
      <line class="clock-hand clock-hand--second" x1="200" y1="232" x2="200" y2="45" />
      <circle cx="200" cy="200" r="9" fill="var(--signal-coral)" />
      <circle cx="200" cy="200" r="3" fill="var(--paper-raised)" />
    </svg>
    <div class="clock-readout"><time data-clock-time></time><span data-clock-zone></span></div>
  </div>
  <div class="hero-console__status" aria-label="平台状态" data-i18n-aria-label="hero.status">
    <span><i></i><b data-i18n="hero.local">100% 浏览器本地运行</b></span>
    <span><i></i><b data-i18n="hero.open">开放源码</b></span>
    <span><i></i><b data-copy-zh={`${count} 个可用工具`} data-copy-en={`${count} tools available`} data-copy-de={`${count} Werkzeuge verfügbar`}>{count} 个可用工具</b></span>
  </div>
</section>
<script>
  import { mountClock } from '../scripts/clock';
  const root = document.querySelector<HTMLElement>('[data-clock]');
  if (root) window.addEventListener('pagehide', mountClock(root), {once:true});
</script>
