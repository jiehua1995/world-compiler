---
import LanguageControl from './LanguageControl.astro';
import SignalMark from './SignalMark.astro';
import ThemeControl from './ThemeControl.astro';

const base = import.meta.env.BASE_URL;
---

<header class="site-header">
  <a class="brand" href={base} aria-label="世界编译局 / World Compiler">
    <SignalMark />
    <span class="brand__copy">
      <strong data-i18n="site.name">世界编译局</strong>
      <span data-i18n="site.tagline">公共工具观测站</span>
    </span>
  </a>
  <nav class="site-nav" aria-label="Primary navigation">
    <a href={base} aria-current="page" data-i18n="nav.home">首页</a>
    <a href={`${base}#tools`} data-i18n="nav.tools">工具目录</a>
    <a href={`${base}#about`} data-i18n="nav.about">关于计划</a>
  </nav>
  <div class="site-header__preferences">
    <LanguageControl />
    <ThemeControl />
  </div>
</header>
