---
import LanguageControl from './LanguageControl.astro';
import SignalMark from './SignalMark.astro';
import ThemeControl from './ThemeControl.astro';

const base = import.meta.env.BASE_URL;
const baseWithSlash = base.endsWith('/') ? base : `${base}/`;
const isTools = Astro.url.pathname.includes('/tools/');
const isAbout = Astro.url.pathname.endsWith('/about/');
---

<header class="site-header">
  <a class="brand" href={baseWithSlash} aria-label="世界编译局 / World Compiler">
    <SignalMark />
    <span class="brand__copy">
      <strong data-i18n="site.name">世界编译局</strong>
      <span data-i18n="site.tagline">公共工具观测站</span>
    </span>
  </a>
  <nav class="site-nav" aria-label="主导航" data-i18n-aria-label="nav.primary">
    <a href={baseWithSlash} aria-current={!isTools && !isAbout ? 'page' : undefined} data-i18n="nav.home">首页</a>
    <a href={`${baseWithSlash}tools/`} aria-current={isTools && Astro.url.pathname.endsWith('/tools/') ? 'page' : undefined} data-i18n="nav.tools">工具目录</a>
    <a href={`${baseWithSlash}about/`} aria-current={isAbout ? 'page' : undefined} data-i18n="nav.about">关于计划</a>
  </nav>
  <div class="site-header__preferences">
    <LanguageControl />
    <ThemeControl />
  </div>
</header>
