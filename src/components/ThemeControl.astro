<div class="preference-control preference-control--theme" role="group" aria-labelledby="theme-label">
  <span id="theme-label" class="preference-control__label" data-i18n="theme.label">主题</span>
  <div class="preference-control__options">
    <button type="button" data-theme-value="system" aria-pressed="true" data-i18n="theme.system">跟随系统</button>
    <button type="button" data-theme-value="light" aria-pressed="false" data-i18n="theme.light">浅色</button>
    <button type="button" data-theme-value="dark" aria-pressed="false" data-i18n="theme.dark">深色</button>
  </div>
</div>
