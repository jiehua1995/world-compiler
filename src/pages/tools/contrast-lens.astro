---
import ContrastLens from '../../components/tools/ContrastLens.astro';
import ToolHeading from '../../components/ToolHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tools } from '../../data/tools';
import '../../styles/workbench.css';
const tool = tools.find(tool => tool.slug === 'contrast-lens')!;
---
<BaseLayout title={tool.title} description={tool.summary}>
  <ToolHeading tool={tool} />
  <ContrastLens />
  <script>
    import { mountContrastLens } from '../../features/contrast-lens/controller';
    const root = document.querySelector<HTMLElement>('[data-contrast-lens]');
    if (root) { const controller = mountContrastLens(root); window.addEventListener('pagehide', () => controller.destroy(), { once:true }); }
  </script>
</BaseLayout>
