---
import PlainLanguageMeter from '../../components/tools/PlainLanguageMeter.astro';
import ToolHeading from '../../components/ToolHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tools } from '../../data/tools';
import '../../styles/workbench.css';
const tool = tools.find(tool => tool.slug === 'plain-language')!;
---
<BaseLayout title={tool.title} description={tool.summary}>
  <ToolHeading tool={tool} />
  <PlainLanguageMeter />
  <script>
    import { mountPlainLanguageMeter } from '../../features/plain-language/controller';
    const root = document.querySelector<HTMLElement>('[data-plain-language]');
    if (root) { const controller = mountPlainLanguageMeter(root); window.addEventListener('pagehide', () => controller.destroy(), { once:true }); }
  </script>
</BaseLayout>
