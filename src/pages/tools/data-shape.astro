---
import DataShaper from '../../components/tools/DataShaper.astro';
import ToolHeading from '../../components/ToolHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tools } from '../../data/tools';
import '../../styles/workbench.css';
const tool = tools.find(tool => tool.slug === 'data-shape')!;
---
<BaseLayout title={tool.title} description={tool.summary}>
  <ToolHeading tool={tool} />
  <DataShaper />
  <script>
    import { mountDataShaper } from '../../features/data-shape/controller';
    const root = document.querySelector<HTMLElement>('[data-data-shaper]');
    if (root) { const controller = mountDataShaper(root); window.addEventListener('pagehide', () => controller.destroy(), { once:true }); }
  </script>
</BaseLayout>
