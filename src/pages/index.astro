---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroConsole from '../components/HeroConsole.astro';
import PrivacyPanel from '../components/PrivacyPanel.astro';
import RoadmapPanel from '../components/RoadmapPanel.astro';
import '../styles/catalog.css';

const base = import.meta.env.BASE_URL;
const baseWithSlash = base.endsWith('/') ? base : `${base}/`;
---

<BaseLayout titleKey="site.title" descriptionKey="site.description">
  <HeroConsole />
  <div class="home-actions">
    <a class="home-actions__link" href={`${baseWithSlash}tools/`} data-i18n="home.catalogCta">浏览工具目录</a>
  </div>
  <PrivacyPanel />
  <RoadmapPanel />
</BaseLayout>
