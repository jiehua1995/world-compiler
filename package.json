{
  "name": "world-compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "predev": "node scripts/copy-pdf-assets.mjs && node scripts/copy-ocr-assets.mjs",
    "prebuild": "node scripts/copy-pdf-assets.mjs && node scripts/copy-ocr-assets.mjs",
    "dev": "astro dev",
    "build": "astro build && node scripts/build-pwa.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "astro": "7.3.8",
    "diff": "^9.0.0",
    "markdown-it": "^15.0.3",
    "markdown-it-task-lists": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vitest": "5.0.4",
    "yaml": "2.9.1"
  }
